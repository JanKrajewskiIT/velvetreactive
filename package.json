{
  "name": "@jankrajewskiit/reactive",
  "version": "3.3.5",
  "description": "Headless SolidJS primitives for HTTP, queries, mutations, and reactive stores.",
  "keywords": [
    "solidjs",
    "solid",
    "http",
    "query",
    "mutation",
    "store"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetreactive.git"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "prettier": "@jankrajewskiit/configs/prettier",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run build && npm run verify:pkg",
    "verify:pkg": "publint --strict && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@12.2.0",
  "peerDependencies": {
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^3.4.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "solid-js": "^1.9.17",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
