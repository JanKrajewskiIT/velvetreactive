{
  "name": "@jankrajewskiit/reactive",
  "version": "3.19.0",
  "description": "Headless SolidJS primitives for HTTP, queries, mutations, and reactive stores.",
  "keywords": [
    "solidjs",
    "solid",
    "http",
    "query",
    "mutation",
    "store"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetreactive.git"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "prettier": "@jankrajewskiit/configs/prettier",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run toolchain && npm run editor:check && npm run format:check && npm run lint && npm run quality:check && npm run build && npm run verify:pkg",
    "verify:pkg": "npm run verify:types && publint --strict && attw --pack . --entrypoints . --profile esm-only",
    "prepare": "husky",
    "toolchain": "configs-toolchain",
    "audit:deps": "configs-audit",
    "prebuild": "npm run toolchain",
    "verify:types": "tsc -p tsconfig.declarations.json",
    "clean": "configs-clean-dist",
    "editor:sync": "configs-editor --write",
    "editor:check": "configs-editor",
    "deps:check": "knip --no-exit-code --reporter json",
    "deps:strict": "configs-unused",
    "architecture:check": "configs-architecture",
    "duplicates:report": "configs-duplicates",
    "quality:check": "npm run architecture:check && npm run duplicates:report && npm run deps:strict"
  },
  "packageManager": "npm@12.2.0",
  "peerDependencies": {
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^3.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "solid-js": "^1.9.17",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "dependency-cruiser": "^18.6.0",
    "jscpd": "~5.4.1"
  },
  "overrides": {
    "eslint": "$eslint"
  }
}
