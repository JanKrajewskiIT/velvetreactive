{
  "name": "@jankrajewskiit/reactive",
  "version": "0.2.0",
  "description": "Headless SolidJS primitives for HTTP, queries, mutations, and reactive stores.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetreactive.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run test:types && node --conditions=browser --test tests",
    "test:types": "tsc -p tests/tsconfig.json",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run verify:pkg",
    "verify:pkg": "publint && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "npm@12.1.0",
  "peerDependencies": {
    "solid-js": ">=1.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^2.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "solid-js": "^1.9.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
